{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // ===================== Provider 矩阵 =====================
  // 所有走 OpenAI 兼容协议的厂商（DeepSeek / SiliconFlow / Kimi / 通义 / vLLM / Ollama / vLLM ...）
  // 统一用 openai-compatible；Azure OpenAI 用 azure；官方 OpenAI 用 openai。
  // 请求体里 providerName 传这里的 key 即可切换；也可以像 SK8 一样直接传 endpoint/apiKey/modelId 动态覆盖。
  "LlmProviders": {
    "deepseek": {
      "kind": "openai-compatible",
      "endpoint": "https://api.deepseek.com/v1",
      "apiKey": "sk-",
      "model": "deepseek-chat"
    }
    //"siliconflow": {
    //  "kind": "openai-compatible",
    //  "endpoint": "https://api.siliconflow.cn/v1",
    //  "apiKey": "sk-ecdytiehajbogjqxpuofrrdcmchadgtgzztbbdphyjuaeern",
    //  "model": "deepseek-ai/DeepSeek-V3"
    //},
    //"azure": {
    //  "kind": "azure",
    //  "endpoint": "https://<your-resource>.openai.azure.com/",
    //  "apiKey": "xxx",
    //  "model": "gpt-4o-mini"
    //},
    //"openai": {
    //  "kind": "openai",
    //  "apiKey": "sk-xxx",
    //  "model": "gpt-4o-mini"
    //},
    //"ollama": {
    //  "kind": "openai-compatible",
    //  "endpoint": "http://localhost:11434/v1",
    //  "apiKey": "ollama",
    //  "model": "qwen3:8b"
    //}
  },

  // ===================== 默认 Agent 行为 =====================
  "AgentDefaults": {
    "systemPrompt": "你是一名热于助人的ai助手。",
    // ChatClientAgent 轻对话模式的上下文压缩预算（对标 SK8 ChatHistoryTruncationReducer）
    "maxContextWindowTokens": 32768,
    "maxOutputTokens": 8192,
    // Harness 长任务模式单次请求的最大模型调用次数（多步推理循环上限）
    "maximumIterationsPerRequest": 40,
    // CodeAct 沙箱使用的 Python 解释器（留空则尝试系统 python）
    "pythonExecutable": "",
    "codeActTimeoutSeconds": 30,
    // 默认启用 CodeAct（Harness 模式）
    "enableCodeAct": true
  },

  // ===================== 知识库（迁移自 SK8，结构不变） =====================
  "VectorDb": "Host=43.130.49.60;Port=5432;Database=mytest;User Id=postgres;Password=lilin1992;SearchPath=public",
  "modelConfig": {
    "embedding": {
      "endpoint": "https://api.siliconflow.cn/v1",
      "apikey": "sk-",
      "model": "BAAI/bge-m3"
    },
    "rerank": {
      "endpoint": "https://api.siliconflow.cn/v1",
      "apikey": "sk-",
      "model": "BAAI/bge-reranker-v2-m3"
    }
  }
}
