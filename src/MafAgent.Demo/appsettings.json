{
  // ===================== MafAgent.Demo 运行配置 =====================
  // 说明：程序启动时读本文件；带 DEMO_ 前缀的环境变量可覆盖同名项
  //（如 DEMO_APIKEY 覆盖 apiKey，便于临时切换不改动文件）

  // OpenAI 兼容服务地址（DeepSeek / SiliconFlow / vLLM / Ollama ...）
  "endpoint": "https://api.deepseek.com/v1",

  // API Key（必填，填你自己的 key，可与 MafAgent.Api 的 appsettings.json 保持一致）
  "apiKey": "sk-",

  // 模型名
  "model": "deepseek-chat",

  // CodeAct 沙箱使用的 Python 解释器；留空则自动用系统 python / python3
  "pythonExecutable": "python"
}
